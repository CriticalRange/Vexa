<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VexaEmulator">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.VexaEmulator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".GameActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|uiMode|layoutDirection"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.VexaEmulator" />

        <service
            android:name=".runtime.RuntimeService"
            android:exported="false"
            android:process=":runtime"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-requested local game emulation with offscreen graphics" />
        </service>

        <service
            android:name=".runtime.RuntimeWorkerService"
            android:exported="false"
            android:process=":runtime_worker" />

        <!-- NoDisplay trampoline for `am start`-driven headless runs. Creates
             no window, so nothing reaches the screen. -->
        <activity
            android:name=".runtime.HeadlessLaunchActivity"
            android:permission="android.permission.DUMP"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />
    </application>

</manifest>