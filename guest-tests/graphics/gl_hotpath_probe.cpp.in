static unsigned queries, capacityQueries, writes, clocks, pixelStores;
static void CountStore(GLenum n, GLint v) { ++pixelStores; glPixelStorei(n,v); }
static void CountGet(GLenum n, GLint* v) { ++queries; glGetIntegerv(n,v); }
static void CountCapacity(GLenum t, GLenum n, GLint64* v) { ++capacityQueries; glGetBufferParameteri64v(t,n,v); }
static void Count1i(GLuint p, GLint l, GLint v) { ++writes; glProgramUniform1i(p,l,v); }
static void Count1f(GLuint p, GLint l, GLfloat v) { ++writes; glProgramUniform1f(p,l,v); }
static void Count4fv(GLuint p, GLint l, GLsizei c, const GLfloat* v) { ++writes; glProgramUniform4fv(p,l,c,v); }
static void Count1iv(GLuint p, GLint l, GLsizei c, const GLint* v) { ++writes; glProgramUniform1iv(p,l,c,v); }
static void CountM4(GLuint p, GLint l, GLsizei c, GLboolean t, const GLfloat* v) { ++writes; glProgramUniformMatrix4fv(p,l,c,t,v); }
static void CountU4(GLint l, GLsizei c, const GLfloat* v) { ++writes; glUniform4fv(l,c,v); }
static void CountU1(GLint l, GLint v) { ++writes; glUniform1i(l,v); }
#define glGetIntegerv CountGet
#define glGetBufferParameteri64v CountCapacity
#define glProgramUniform1i Count1i
#define glProgramUniform1f Count1f
#define glProgramUniform4fv Count4fv
#define glProgramUniform1iv Count1iv
#define glProgramUniformMatrix4fv CountM4
#define glUniform4fv CountU4
#define glUniform1i CountU1
#define glPixelStorei CountStore
static uint64_t GLHostNowNs() { ++clocks; return std::chrono::steady_clock::now().time_since_epoch().count(); }
