       }
     }
     Result = ::mprotect(addr, len, prot);
+#if defined(__ANDROID__)
+    if (Result == -1 && errno == EACCES && (prot & PROT_EXEC)) {
+      Result = ::mprotect(addr, len, (prot & ~PROT_EXEC) | PROT_READ);
+    }
+#endif
     if (Result == -1) {
       return -errno;
     }
